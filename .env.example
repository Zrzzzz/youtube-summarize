# ===== 腾讯云 ASR（控制台 → 访问管理 → API 密钥管理）=====
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# ASR_REGION=ap-shanghai
# 中文视频 16k_zh，英文视频 16k_en（标准引擎，走免费资源包）；
# 16k_zh_large 大模型版支持中英粤混合，但属于单独计费 SKU，免费包不覆盖
# ASR_ENGINE_MODEL=16k_zh

# ===== DeepSeek（https://platform.deepseek.com）=====
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# MAX_TRANSCRIPT_CHARS=80000

# ===== 发件邮箱（163 SMTP，国内直连）=====
# 163 邮箱网页版 → 设置 → POP3/SMTP/IMAP → 开启 SMTP 服务，获取「授权码」
SMTP_USER=xxx@163.com
SMTP_PASS=授权码（不是登录密码）
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# 默认收件人，网页/命令行不填邮箱时使用
DEFAULT_RECIPIENT=

# ===== 其他 =====
# 代理只用于 YouTube 下载和 Gmail/Google；腾讯云与 DeepSeek 始终直连国内网络
# PROXY=http://127.0.0.1:7897
# YouTube 提示「Sign in to confirm you're not a bot」时配置 cookies（二选一）：
# YTDLP_COOKIES_BROWSER=chrome
# YTDLP_COOKIES_FILE=cookies.txt
# yt-dlp 被风控拦截时的回退下载通道（Piped 公共实例，逗号分隔可填多个）
# PIPED_INSTANCES=https://api.piped.private.coffee
# DOWNLOAD_DIR=downloads
